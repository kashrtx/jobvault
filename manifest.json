{
  "manifest_version": 3,
  "name": "JobVault",
  "version": "2.3.0",
  "description": "Job application command centre. Fills the right login for the right Workday tenant, fills the 40-field application form, and tracks every job you save or apply to.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobVault (Ctrl+Shift+Y)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkdaysite.com/*",
        "*://*.myworkday.com/*",
        "*://*.wd1.myworkdayjobs.com/*",
        "*://boards.greenhouse.io/*",
        "*://job-boards.greenhouse.io/*",
        "*://*.greenhouse.io/*",
        "*://jobs.lever.co/*",
        "*://*.lever.co/*",
        "*://jobs.ashbyhq.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.workable.com/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.successfactors.com/*",
        "*://*.successfactors.eu/*",
        "*://*.sapsf.com/*",
        "*://*.sapsf.eu/*",
        "*://*.bamboohr.com/*",
        "*://*.jobvite.com/*",
        "*://*.teamtailor.com/*",
        "*://*.breezy.hr/*",
        "*://*.recruitee.com/*",
        "*://*.personio.de/*",
        "*://*.personio.com/*",
        "*://*.pinpointhq.com/*",
        "*://*.eightfold.ai/*",
        "*://*.rippling.com/*",
        "*://*.oraclecloud.com/*",
        "*://*.dayforcehcm.com/*",
        "*://*.ultipro.com/*",
        "*://*.ukg.net/*",
        "*://*.adp.com/*",
        "*://*.paylocity.com/*",
        "*://*.paycom.com/*",
        "*://*.phenompeople.com/*",
        "*://*.avature.net/*",
        "*://*.csod.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open JobVault"
    },
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Fill the login on this page"
    },
    "fill-application": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill the application form on this page"
    },
    "save-job": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save this job to the tracker"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "*://*/*"
  ]
}
